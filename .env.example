# Salin file ini jadi .env (JANGAN commit .env). Isi dengan URL staging yang kamu punya izin untuk ditest.
ENV=staging
BASE_URL=

# Daftar role (huruf kecil, dipisah koma, tanpa "-"). Tiap role punya folder tests/<role>/.
ROLES=polres,polda,bareskrim

# Akun UJI per role: <ROLE>_USERNAME dan <ROLE>_PASSWORD (nama role HURUF BESAR).
# Jangan pernah pakai akun/data asli.
POLRES_USERNAME=
POLRES_PASSWORD=
POLDA_USERNAME=
POLDA_PASSWORD=
BARESKRIM_USERNAME=
BARESKRIM_PASSWORD=

# Login otomatis (globalSetup)
# LOGIN_MAX_ATTEMPTS=5     # ulang login kalau "reCAPTCHA gagal diverifikasi"
# AUTH_MAX_AGE_HOURS=8     # sesi di .auth/ yang lebih muda dari ini dipakai ulang tanpa login
# FORCE_LOGIN=true         # paksa login ulang walau sesi masih baru

# File untuk test upload (path lokal di mesin masing-masing, boleh pakai tanda kutip)
UPLOAD_SURAT_PDF=
UPLOAD_BUKTI_IMG=
