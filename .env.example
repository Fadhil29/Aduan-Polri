# Salin file ini jadi .env (JANGAN commit .env). Isi dengan URL staging yang kamu punya izin untuk ditest.
ENV=staging
BASE_URL=

# Daftar role (huruf kecil, dipisah koma, tanpa "-"). Tiap role punya folder tests/<role>/.
ROLES=polres,polda,bareskrim

# Akun UJI per role: <ROLE>_USERNAME dan <ROLE>_PASSWORD (nama role HURUF BESAR).
# Jangan pernah pakai akun/data asli.
POLRES_USERNAME=
POLRES_PASSWORD=
POLDA_USERNAME=
POLDA_PASSWORD=
BARESKRIM_USERNAME=
BARESKRIM_PASSWORD=
