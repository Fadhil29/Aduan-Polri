{
  "name": "aduan-polri-playwright",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "codegen": "tsx scripts/codegen.ts record",
    "codegen:auth": "tsx scripts/codegen.ts auth",
    "auth": "tsx scripts/auth.ts",
    "setup": "playwright test --project=login-check",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
